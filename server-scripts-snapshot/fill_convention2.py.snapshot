#!/usr/bin/env python3
import sys, json, os, subprocess
from docx import Document
from datetime import datetime
APP = '/var/www/vhosts/linguaid.net/eval.linguaid.net/app'
VIEWS = os.path.join(APP, 'views')
OUTPUT_DIR = os.path.join(APP, 'data', 'conventions')
TEMPLATES = {
    'NON_CPF': os.path.join(VIEWS, 'CONVENTION_TEMPLATE_NON_CPF.docx'),
    'CPF':     os.path.join(VIEWS, 'CONVENTION_CPF_E360.docx'),
    'CAJA':    os.path.join(VIEWS, 'CONVENTION_CPF_CAJA.docx'),
    'E360':    os.path.join(VIEWS, 'CONVENTION_CPF_E360.docx'),
    'PARCOURS': os.path.join(VIEWS, 'CONVENTION_PARCOURS_CAJA.docx'),  # PARCOURS_CAJA_20260911
}
os.makedirs(OUTPUT_DIR, exist_ok=True)

def rep_para(para, reps):
    # Check if any placeholder spans multiple runs with different formatting
    # by replacing within each run individually first
    for r in para.runs:
        if r.text:
            for t, v in reps.items():
                if t in r.text:
                    r.text = r.text.replace(t, str(v))
    # Fall back: if any placeholder still spans across runs, do full join
    full = ''.join(r.text for r in para.runs)
    for t, v in reps.items():
        if t in full:
            full = full.replace(t, str(v))
            if para.runs:
                para.runs[0].text = full
                for r in para.runs[1:]: r.text = ''
            break

def rep_doc(doc, reps):
    for p in doc.paragraphs:
        if any(t in ''.join(r.text for r in p.runs) for t in reps):
            rep_para(p, reps)
    for tbl in doc.tables:
        for row in tbl.rows:
            for cell in row.cells:
                for p in cell.paragraphs:
                    if any(t in ''.join(r.text for r in p.runs) for t in reps):
                        rep_para(p, reps)

# INSTALMENTS_20260911: payment schedule wording for Article 3.
# instalments 1 = legacy wording; 2-4 = monthly instalments, first one on
# receipt of invoice. Amounts split to the cent, last instalment absorbs
# the rounding so the total always equals the price.
def payment_terms(data):
    try:
        n = int(str(data.get('instalments') or 1))
    except Exception:
        n = 1
    n = max(1, min(4, n))
    if n == 1:
        return '\u00e0 payer \u00e0 r\u00e9ception de facture'
    try:
        price = float(str(data.get('price', '')).replace('\u20ac', '').replace(' ', '').replace(',', '.'))
    except Exception:
        price = 0
    def fmt(x):
        s = ('%.2f' % x)
        if s.endswith('.00'):
            s = s[:-3]
        return s.replace('.', ',') + ' \u20ac'
    detail = ''
    if price > 0:
        base = round(price / n, 2)
        amounts = [base] * (n - 1) + [round(price - base * (n - 1), 2)]
        if len(set(amounts)) == 1:
            detail = ' de ' + fmt(base) + ' chacune'
        else:
            detail = ' (' + ', '.join(fmt(a) for a in amounts[:-1]) + ' et ' + fmt(amounts[-1]) + ')'
    return ('payables en ' + str(n) + ' \u00e9ch\u00e9ances mensuelles' + detail +
            ', la premi\u00e8re \u00e0 r\u00e9ception de facture')

# PARCOURS_CAJA_20260911: placeholders for CONVENTION_PARCOURS_CAJA.docx.
# data['parcours'] = { calc: <lib/parcours.js compute()>, lines: [...], fmt: {...} }
def _pc_eur(n):
    try:
        n = float(n)
    except Exception:
        return '\u2014'
    s = ('%.2f' % n)
    if s.endswith('.00'):
        s = s[:-3]
    whole, _, dec = s.partition('.')
    whole = '{:,}'.format(int(whole)).replace(',', '\u00a0')
    return (whole + (',' + dec if dec else '')) + '\u00a0\u20ac'
def _pc_date_str(m, fmt_date):
    ds, de = m.get('dateStart') or '', m.get('dateEnd') or ''
    if ds and de:
        return 'du ' + fmt_date(ds) + ' au ' + fmt_date(de)
    if ds:
        return '\u00e0 partir du ' + fmt_date(ds)
    return 'dates \u00e0 convenir entre les parties'
def parcours_reps(data):
    pc = (data.get('parcours') or {}).get('calc') or {}
    if not pc:
        return {}
    MFR = {1:'janvier',2:'f\u00e9vrier',3:'mars',4:'avril',5:'mai',6:'juin',7:'juillet',8:'ao\u00fbt',9:'septembre',10:'octobre',11:'novembre',12:'d\u00e9cembre'}
    def fmt_date(iso):
        try:
            y, mo, d = str(iso)[:10].split('-')
            return str(int(d)) + ' ' + MFR[int(mo)] + ' ' + y
        except Exception:
            return str(iso)
    mods = pc.get('modules') or [{}, {}]
    m1, m2 = mods[0], mods[1]
    tot = pc.get('totals') or {}
    balance = pc.get('cpfBalance')
    if pc.get('balanceKnown') and balance is not None:
        funding = ('Sur la base du cr\u00e9dit CPF constat\u00e9 \u00e0 la signature (' + _pc_eur(balance) + '), la prise en charge pr\u00e9visionnelle est de '
                   + _pc_eur(m1.get('cpfPart')) + ' pour le Module 1 et ' + _pc_eur(m2.get('cpfPart')) + ' pour le Module 2, soit '
                   + _pc_eur(tot.get('learner')) + ' restant \u00e0 la charge du stagiaire pour l\u2019ensemble du parcours (compl\u00e9ments et participations forfaitaires compris).')
    else:
        funding = ('La prise en charge par le CPF est plafonn\u00e9e \u00e0 ' + _pc_eur(pc.get('cpfCap')) + ' par module et d\u00e9pend du cr\u00e9dit disponible sur le compte du stagiaire au moment de chaque inscription\u00a0; '
                   + 'sur la base d\u2019une prise en charge maximale, ' + _pc_eur(tot.get('learner')) + ' resteraient \u00e0 la charge du stagiaire pour l\u2019ensemble du parcours.')
    n_inst = int(m2.get('instalments') or 4)
    if n_inst < 2:
        n_inst = 4
    try:
        m2_price = float(m2.get('price') or 0)
    except Exception:
        m2_price = 0
    base = round(m2_price / n_inst, 2)
    direct_terms = ('payable en ' + str(n_inst) + ' \u00e9ch\u00e9ances mensuelles de ' + _pc_eur(base) + ', la premi\u00e8re \u00e0 r\u00e9ception de facture')
    dedit = '30\u00a0% du prix du Module 2, soit ' + _pc_eur(round(m2_price * 0.3, 2))
    return {
        '{{M1_TITLE}}':            m1.get('title', ''),
        '{{M2_TITLE}}':            m2.get('title', ''),
        '{{M1_TOTAL_HOURS}}':      str(m1.get('totalHours', '')),
        '{{M2_TOTAL_HOURS}}':      str(m2.get('totalHours', '')),
        '{{PARCOURS_TOTAL_HOURS}}': str(tot.get('totalHours', '')),
        '{{M1_DATE_STR}}':         _pc_date_str(m1, fmt_date),
        '{{M2_DATE_STR}}':         _pc_date_str(m2, fmt_date),
        '{{M1_PRICE}}':            str(int(float(m1.get('price') or 0))),
        '{{M2_PRICE}}':            str(int(float(m2.get('price') or 0))),
        '{{PARCOURS_TOTAL}}':      str(int(float(tot.get('price') or 0))),
        '{{PARCOURS_MONTHS}}':     str(pc.get('maxMonths', 12)),
        '{{PARCOURS_FUNDING}}':    funding,
        '{{M2_DIRECT_TERMS}}':     direct_terms,
        '{{M2_DEDIT}}':            dedit,
    }

def fill_convention(data):
    tt = data.get('trainingType', 'NON_CPF')
    tpl_key = 'PARCOURS' if tt == 'PARCOURS' else 'CAJA' if tt == 'CAJA' else 'E360' if tt == 'E360' else 'CPF' if tt == 'CPF' else 'NON_CPF'  # PARCOURS_CAJA_20260911
    tpl = TEMPLATES[tpl_key]
    if not os.path.exists(tpl):
        raise FileNotFoundError('Template not found: ' + tpl)
    doc = Document(tpl)
    MFR = {1:'janvier',2:'février',3:'mars',4:'avril',5:'mai',6:'juin',
           7:'juillet',8:'août',9:'septembre',10:'octobre',11:'novembre',12:'décembre'}
    now = datetime.now()
    today = str(now.day) + ' ' + MFR[now.month] + ' ' + str(now.year)
    name = data.get('candidateName', '')
    civ = data.get('civility', 'Madame')
    reps = {
        '{{CANDIDATE_NAME}}':     name,
        '{{CIVILITY}}':           civ,
        '{{COMPANY_NAME}}':       data.get('companyName', ''),
        '{{COMPANY_SIRET}}':      data.get('companySiret', ''),
        '{{SIRET}}':              data.get('companySiret', ''),
        '{{TOTAL_HOURS}}':        str(data.get('totalHours', 20)),
        '{{COACHING_HOURS}}':     str(data.get('coachingHours', 10)),
        '{{HOMEWORK_HOURS}}':     str(data.get('homeworkHours', 10)),
        '{{PREREQ_LEVEL}}':       str(data.get('prereqLevel', 'A2')),
        '{{TARGET_LEVEL}}':       str(data.get('targetLevel', 'B2')),
        '{{PREREQ_LEVEL}}':       data.get('prereqLevel', ''),
        '{{PREREQ_DESCRIPTION}}': data.get('prereqLevel', ''),
        '{{TARGET_LEVEL}}':       data.get('targetLevel', 'B2'),
        '{{TARGET_DESCRIPTION}}': data.get('targetLevel', 'B2'),
        '{{LOCATION}}':           data.get('location', 'A distance'),
        '{{DATE_STR}}':           data.get('dateStr', ''),
        '{{PRICE}}':              str(data.get('price', '')),
        '{{TODAY}}':              today,
        '{{SIGN_CITY}}':          'Saint-Cyprien',
        '{{SIGNATORY}}':          data.get('companyName', name),
        '{{TRAINING_TITLE}}':     data.get('trainingTitle', 'Formation en anglais professionnel'),
        # RS7637 registry (2026-07-27): candidate's own stamped RS code,
        # threaded in from routes/api.js generate-convention. Fallback only
        # covers a payload that somehow never got an rsCode field.
        '{{RS_CODE}}':            data.get('rsCode') or 'RS7637',
        '{{PAYMENT_TERMS}}':    payment_terms(data),
    }
    reps.update(parcours_reps(data))  # PARCOURS_CAJA_20260911
    rep_doc(doc, reps)

    # ARTICLE4_DELIVERY (2026-08-25): Article 4 carried a fixed
    # "et, le cas echeant, des activites de travail guide en autonomie".
    # For a blended parcours those hours are contractual, not conditional;
    # for a coaching-only parcours they must not appear at all. Rewritten
    # here from coachingHours / homeworkHours. Paragraph-level replacement
    # because the sentence is split across runs in the template.
    def _art4_hours(v):
        try:
            return int(float(str(v).strip() or 0))
        except Exception:
            return 0

    _a4_coach = _art4_hours(data.get('coachingHours'))
    _a4_home = _art4_hours(data.get('homeworkHours'))
    _a4_text = None
    if _a4_home > 0 and _a4_coach > 0:
        _a4_text = (
            'Formation individuelle \u00e0 distance en modalit\u00e9 mixte, comprenant '
            + str(_a4_coach) + ' heures de coaching individuel en visioconf\u00e9rence et '
            + str(_a4_home) + ' heures de travail guid\u00e9 en autonomie. Les s\u00e9ances '
            'sont organis\u00e9es selon un calendrier convenu entre le formateur et le '
            'stagiaire. Le suivi de l\u2019ex\u00e9cution est assur\u00e9 par des feuilles '
            'd\u2019\u00e9margement \u00e9lectroniques ou relev\u00e9s de connexion sign\u00e9s '
            '\u00e0 l\u2019issue de chaque s\u00e9ance et, pour les activit\u00e9s r\u00e9alis\u00e9es '
            'en autonomie, par les travaux rendus et leur validation par le formateur.'
        )
    elif _a4_coach > 0:
        _a4_text = (
            'Formation individuelle \u00e0 distance comprenant '
            + str(_a4_coach) + ' heures de s\u00e9ances de coaching en visioconf\u00e9rence. '
            'Les s\u00e9ances sont organis\u00e9es selon un calendrier convenu entre le '
            'formateur et le stagiaire. Le suivi de l\u2019ex\u00e9cution est assur\u00e9 par '
            'des feuilles d\u2019\u00e9margement \u00e9lectroniques ou relev\u00e9s de connexion '
            'sign\u00e9s \u00e0 l\u2019issue de chaque s\u00e9ance.'
        )

    if _a4_text:
        for _p in doc.paragraphs:
            _t = ''.join(_r.text for _r in _p.runs)
            if 'Formation individuelle' in _t and 'coaching en visioconf' in _t:
                if _p.runs:
                    _p.runs[0].text = _a4_text
                    for _r in _p.runs[1:]:
                        _r.text = ''
                break

    token = data.get('signingToken', 'draft')
    docx_path = os.path.join(OUTPUT_DIR, 'convention_' + token + '.docx')
    # Remove 'Niveau vise' bullet for legal candidates
    if data.get('courseType') == 'legal':
        for p in list(doc.paragraphs):
            if 'Niveau vis' in p.text or 'TARGET_DESCRIPTION' in p.text:
                p._element.getparent().remove(p._element)

    doc.save(docx_path)
    r = subprocess.run(
        ['libreoffice', '--headless', '--convert-to', 'pdf', '--outdir', OUTPUT_DIR, docx_path],
        capture_output=True, text=True, timeout=60
    )
    if r.returncode != 0:
        raise RuntimeError('LibreOffice failed: ' + r.stderr)
    pdf_path = os.path.join(OUTPUT_DIR, 'convention_' + token + '.pdf')
    if not os.path.exists(pdf_path):
        base = os.path.splitext(os.path.basename(docx_path))[0]
        alt = os.path.join(OUTPUT_DIR, base + '.pdf')
        if os.path.exists(alt):
            os.rename(alt, pdf_path)
        else:
            raise RuntimeError('PDF not found after conversion')
    return pdf_path

if __name__ == '__main__':
    if len(sys.argv) < 2:
        print(json.dumps({'error': 'No JSON argument'}))
        sys.exit(1)
    try:
        pdf = fill_convention(json.loads(sys.argv[1]))
        print(json.dumps({'success': True, 'pdfPath': pdf}))
    except Exception as e:
        import traceback
        print(json.dumps({'error': str(e), 'trace': traceback.format_exc()}))
        sys.exit(1)

