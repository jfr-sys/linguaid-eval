#!/usr/bin/env python3
"""
fill_proposition.py — fills PROPOSITION_TEMPLATE.docx with candidate data.
Usage: python3 fill_proposition.py <data.json> <template.docx> <output.docx>

Key design decisions:
- Simple placeholder substitution wherever possible (no XML surgery)
- {{IF_CPF}}...{{END_CPF}} and {{IF_NON_CPF}}...{{END_NON_CPF}} blocks removed if not applicable
- {{OBJECTIF_6}} removed if not CAJA
- {{ETAPE_2}} removed if not E360_LEGAL, filled if it is
- {{FORMATEUR}} line removed if homeworkHours == 0 (no travail guidé row either)
- pgMar bottom=2800, footer=400 always enforced (proven working values)
- Header/footer references in sectPr never touched
"""
import sys, os, json, zipfile, shutil, tempfile
from lxml import etree
from copy import deepcopy

W = 'http://schemas.openxmlformats.org/wordprocessingml/2006/main'

def q(t):
    return '{%s}%s' % (W, t)

def para_text(p):
    return ''.join(t.text or '' for t in p.iter(q('t')))

def set_para_text(p, text):
    """Replace all text in paragraph preserving first run formatting."""
    runs = list(p.iter(q('r')))
    if not runs:
        r = etree.SubElement(p, q('r'))
        t_el = etree.SubElement(r, q('t'))
        t_el.text = text
        if text and (text[0] == ' ' or text[-1] == ' '):
            t_el.set('{http://www.w3.org/XML/1998/namespace}space', 'preserve')
        return
    first_t = runs[0].find(q('t'))
    if first_t is None:
        first_t = etree.SubElement(runs[0], q('t'))
    first_t.text = text
    if text and (text[0] == ' ' or text[-1] == ' '):
        first_t.set('{http://www.w3.org/XML/1998/namespace}space', 'preserve')
    for r in runs[1:]:
        for t_el in r.findall(q('t')):
            t_el.text = ''

def replace_in_para(p, placeholder, value):
    """Replace placeholder text within runs of a paragraph, handling split runs."""
    full = para_text(p)
    if placeholder not in full:
        return False
    # Try simple single-run replacement first
    for r in p.iter(q('r')):
        t_el = r.find(q('t'))
        if t_el is not None and t_el.text and placeholder in t_el.text:
            t_el.text = t_el.text.replace(placeholder, value)
            if t_el.text and (t_el.text[0] == ' ' or t_el.text[-1] == ' '):
                t_el.set('{http://www.w3.org/XML/1998/namespace}space', 'preserve')
            return True
    # Fallback: placeholder split across runs — replace in concatenated text
    new_text = full.replace(placeholder, value)
    set_para_text(p, new_text)
    return True

def find_para_with(root, text):
    for p in root.iter(q('p')):
        if text in para_text(p):
            return p
    return None

def remove_para(p):
    parent = p.getparent()
    if parent is not None:
        parent.remove(p)

def remove_block(root, start_marker, end_marker):
    """Remove all paragraphs from start_marker para to end_marker para inclusive."""
    paras = list(root.iter(q('p')))
    in_block = False
    to_remove = []
    for p in paras:
        pt = para_text(p).strip()
        if pt == start_marker:
            in_block = True
        if in_block:
            to_remove.append(p)
        if in_block and pt == end_marker:
            in_block = False
    for p in to_remove:
        remove_para(p)

def keep_block_remove_markers(root, start_marker, end_marker):
    """Keep content between markers but remove the marker paragraphs themselves."""
    paras = list(root.iter(q('p')))
    for p in paras:
        pt = para_text(p).strip()
        if pt in (start_marker, end_marker):
            remove_para(p)


# ── Trainer profile strings ──────────────────────────────────────────────────
FORMATEUR_BUSINESS = (
    "Formateur expert en anglais professionnel, \u00e0 distance en visioconf\u00e9rence individuelle"
)
FORMATEUR_LEGAL = (
    "Formateur anglophone natif, ancien avocat, sp\u00e9cialis\u00e9 exclusivement dans l\u2019enseignement "
    "de l\u2019anglais juridique des affaires \u2014 un profil rare en France"
)

# ── Certification strings ────────────────────────────────────────────────────
# RS7637 registry (2026-07-27): the E360 RS code is no longer hardcoded here.
# It is read per-candidate from data['rsCode'], stamped by
# routes/programme.js at the moment cpfType is chosen (see config/catalogue.js
# REFERENTIALS). Candidates already in flight before the cutover were
# grandfathered onto RS6341 by patch_rs7637_data_migration_v1.py, so a
# missing rsCode here should never silently happen for a real candidate —
# the RS7637 fallback below is a last-resort safety net only.
def certification_e360(rs_code):
    return u"English 360 \u2013 Communiquer en anglais professionnel (%s)" % rs_code

CERTIFICATION_CAJA = "CAJA \u2013 Communiquer en anglais juridique des affaires (RS6810)"
CERTIFICATION_NONE = "Aucune (formation non certifiante)"

# PARCOURS_PROPOSITION_20260922: Module 2 (CAJA, RS6810) referential objectives,
# identical to REFERENTIAL_OBJECTIVES.CAJA in routes/programme.js.
CAJA_OBJECTIVES = [
    u"Se pr\u00e9senter dans un cadre professionnel et \u00e9tablir un bon contact avec un client, un coll\u00e8gue ou un confr\u00e8re",
    u"Mener un premier entretien pour comprendre la situation, poser les bonnes questions et identifier les attentes",
    u"Expliquer une probl\u00e9matique juridique, proposer des options et aider \u00e0 la prise de d\u00e9cision",
    u"R\u00e9diger des documents professionnels adapt\u00e9s au contexte\u00a0: emails, lettres, notes d\u2019avocat",
    u"Corriger ou r\u00e9diger des clauses contractuelles claires, pr\u00e9cises et structur\u00e9es",
    u"Conduire une n\u00e9gociation, formuler ou r\u00e9pondre \u00e0 des propositions, et d\u00e9fendre les int\u00e9r\u00eats de son client",
]
TITRE_PARCOURS = u"Proposition de parcours de formation en anglais juridique des affaires \u2013 deux modules"

def _eur(n):
    try:
        v = float(n)
    except (TypeError, ValueError):
        return u'\u2014'
    s = ('%.2f' % v)
    if s.endswith('.00'):
        s = s[:-3]
    ip, _, dp = s.partition('.')
    ip = '{:,}'.format(int(ip)).replace(',', u'\u00a0')
    return (ip + (',' + dp if dp else '')) + u'\u00a0\u20ac'

def _fmt_date_fr(iso):
    if not iso:
        return u''
    try:
        y, m, d = str(iso)[:10].split('-')
        mois = [u'janvier', u'f\u00e9vrier', u'mars', u'avril', u'mai', u'juin', u'juillet', u'ao\u00fbt', u'septembre', u'octobre', u'novembre', u'd\u00e9cembre']
        return u'%d %s %s' % (int(d), mois[int(m) - 1], y)
    except Exception:
        return str(iso)

def _row_of(p):
    el = p
    for _ in range(6):
        if el is None:
            return None
        if el.tag == q('tr'):
            return el
        el = el.getparent()
    return None

def _set_cell_texts(tr, cell_idx, texts):
    """Set the paragraphs of table cell cell_idx to texts (list); extra paragraphs cleared."""
    tcs = list(tr.iter(q('tc')))
    if cell_idx >= len(tcs):
        return
    ps = list(tcs[cell_idx].iter(q('p')))
    for i, p in enumerate(ps):
        set_para_text(p, texts[i] if i < len(texts) else u'')

# ── Title strings ────────────────────────────────────────────────────────────
TITRE_E360       = "Proposition de formation en anglais professionnel"
TITRE_E360_LEGAL = "Proposition de formation en anglais professionnel \u2013 parcours professionnel du droit"
TITRE_CAJA       = "Proposition de formation en anglais juridique des affaires"
TITRE_NON_CPF_BUSINESS = "Proposition de formation en anglais professionnel"
TITRE_NON_CPF_LEGAL    = "Proposition de formation en anglais juridique"

# ── Opening line ─────────────────────────────────────────────────────────────
INTRO_CPF = (
    "Suite \u00e0 notre \u00e9change et \u00e0 votre \u00e9valuation, j\u2019ai le plaisir de vous adresser "
    "cette proposition de formation en anglais, con\u00e7ue pour r\u00e9pondre \u00e0 vos besoins tout en "
    "permettant une prise en charge via le CPF."
)
INTRO_NON_CPF = (
    "Suite \u00e0 notre \u00e9change et \u00e0 votre \u00e9valuation, j\u2019ai le plaisir de vous adresser "
    "cette proposition de formation en anglais, con\u00e7ue pour r\u00e9pondre \u00e0 vos besoins."
)

# ── Étape 2 text (E360_LEGAL only) ──────────────────────────────────────────
ETAPE_2_TEXT = (
    "\u00c9tape 2 (facultative) \u2014 \u00c0 l\u2019issue de cette formation, vous disposerez de "
    "l\u2019attestation de niveau B2 requise comme pr\u00e9requis \u00e0 notre certification "
    "\u00ab\u00a0CAJA \u2013 Communiquer en anglais juridique des affaires\u00a0\u00bb (RS6810), "
    "si vous souhaitez aller plus loin dans votre ma\u00eetrise de l\u2019anglais juridique."
)


def fill_proposition(data, template_path, output_path):
    tmpdir = tempfile.mkdtemp()
    try:
        with zipfile.ZipFile(template_path, 'r') as z:
            z.extractall(tmpdir)

        doc_path = os.path.join(tmpdir, 'word', 'document.xml')
        tree = etree.parse(doc_path)
        root = tree.getroot()
        body = root.find(q('body'))

        # ── Extract data fields ──────────────────────────────────────────────
        isCPF       = data.get('isCPF', False)
        cpfType     = data.get('cpfType', '')        # 'E360', 'E360_LEGAL', 'CAJA'
        # RS7637 registry (2026-07-27): fallback only fires if Node forgot
        # to send rsCode - should not happen for any real candidate record.
        rsCode      = data.get('rsCode', 'RS7637')
        courseType  = data.get('courseType', '')     # 'legal' or ''
        isLegal     = courseType == 'legal' or cpfType in ('E360_LEGAL', 'CAJA')

        civility    = data.get('civility', 'Madame')
        firstName   = data.get('firstName', '')
        lastName    = data.get('lastName', '')
        fullName    = (firstName + ' ' + lastName).strip() or data.get('candidateName', '')
        # TIERS_WORDING_FIX (2026-07-03): non-CPF proposals addressed to a
        # third party (tiers company contact, or contrat-cadre HR contact) must
        # refer to the candidate in the third person, never 'vous'/'vos besoins'.
        # CPF proposals are explicitly out of scope (the CPF block tells the
        # reader to act on THEIR OWN CPF account - only makes sense addressed
        # to the candidate).
        recipientType = data.get('recipientType', 'learner')
        # TIERS_HEADER_20260918: company contact for the address block in
        # tiers mode (sent by routes/programme.js from the picker / persisted
        # thirdParty* fields). Empty dict when absent or in learner mode.
        tiers = data.get('tiers') or {}
        company     = data.get('company', '')
        email       = data.get('email', '')

        prereqLevel = data.get('prereqLevel', '')
        targetLevel = data.get('targetLevel', '')
        totalHours  = str(data.get('totalHours', ''))
        coachingH   = str(data.get('coachingHours', ''))
        homeworkH   = str(data.get('homeworkHours', '0'))
        hasHomework = homeworkH not in ('0', '', 'None', '-')

        dateStart   = data.get('dateStart', 'À définir')
        dateEnd     = data.get('dateEnd', 'À définir')
        objectives  = data.get('objectives', [])
        resumeSituation = data.get('resumeSituation', '')  # AI-generated needs summary
        # RENEWAL_PROPOSITION_FIX (2026-07-30): renewals (known returning
        # clients, no fresh evaluation on record) get a different profile
        # section and CPF-funding presentation - see the block before the
        # substitution loop below.
        isRenewal   = bool(data.get('isRenewal'))

        price       = data.get('price', '')
        edofMCFLink = data.get('edofMCFLink', '')

        # CPF budget calc: solde = price + 150 - 1500
        try:
            price_int = int(float(str(price)))
            cpf_montant = 1500
            reste_charge = max(0, price_int + 150 - 1500)
        except (ValueError, TypeError):
            price_int = 0
            cpf_montant = 1500
            reste_charge = 0

        # PARCOURS_CAJA_20260911: two-module parcours -> Module 1 funding split
        # comes from lib/parcours.js (CPF cap per dossier, forfait, remainder).
        parcours = data.get('parcours') or None
        if parcours and parcours.get('calc') and parcours['calc'].get('modules'):
            _m1 = parcours['calc']['modules'][0]
            try:
                cpf_montant = int(round(float(_m1.get('cpfPart') or 0)))
                reste_charge = int(round(float(_m1.get('learnerPays') or 0)))
                price_int = int(round(float(_m1.get('price') or price_int)))
            except (ValueError, TypeError):
                pass

        # Non-CPF price calc if not provided
        if not price and not isCPF:
            try:
                ch = int(float(coachingH))
                hw = int(float(homeworkH)) if hasHomework else 0
                if isLegal:
                    price_int = ch * 132 + (200 if hw > 0 else 0)
                else:
                    price_int = ch * 90 + hw * 30
                price = str(price_int)
            except (ValueError, TypeError):
                price = ''

        # ── Determine strings by type ────────────────────────────────────────
        if isCPF:
            if cpfType == 'CAJA':
                titre = TITRE_CAJA
                certification = CERTIFICATION_CAJA
                formateur = FORMATEUR_LEGAL
            elif cpfType == 'E360_LEGAL':
                titre = TITRE_E360_LEGAL
                certification = certification_e360(rsCode)
                formateur = FORMATEUR_LEGAL
                if parcours and parcours.get('calc'):
                    titre = TITRE_PARCOURS  # PARCOURS_PROPOSITION_20260922
            else:  # E360
                titre = TITRE_E360
                certification = certification_e360(rsCode)
                formateur = FORMATEUR_BUSINESS
            intro = INTRO_CPF
        else:
            titre = TITRE_NON_CPF_LEGAL if isLegal else TITRE_NON_CPF_BUSINESS
            certification = CERTIFICATION_NONE
            formateur = FORMATEUR_LEGAL if isLegal else FORMATEUR_BUSINESS
            if recipientType == 'hr':
                intro = (
                    u"Suite \u00e0 l\u2019\u00e9valuation linguistique de " + fullName + u" et \u00e0 nos \u00e9changes, "
                    u"j\u2019ai le plaisir de vous adresser cette proposition de formation en anglais, "
                    u"con\u00e7ue pour r\u00e9pondre \u00e0 ses besoins."
                )
            else:
                intro = INTRO_NON_CPF

        # ── Simple placeholder substitutions ─────────────────────────────────
        # TIERS_HEADER_20260918: non-CPF proposal addressed to a third party ->
        # header names the company contact; learner fields are the fallback
        # whenever the contact is incomplete, so nothing is ever left blank.
        hdr_civility, hdr_name, hdr_email = civility, fullName, email
        if (not isCPF) and recipientType == 'hr' and tiers:
            _tn = ((tiers.get('prenom') or '') + ' ' + (tiers.get('nom') or '')).strip()
            if _tn:
                hdr_name = _tn
                hdr_civility = (tiers.get('civility') or '').strip()
            if (tiers.get('email') or '').strip():
                hdr_email = tiers['email'].strip()

        substitutions = {
            '{{TITRE}}':          titre,
            '{{CIVILITE}} {{NOM_COMPLET}}': (hdr_civility + ' ' + hdr_name).strip(),
            '{{CIVILITE}}':       hdr_civility,
            '{{NOM_COMPLET}}':    hdr_name,
            '{{ENTREPRISE}}':     company,
            '{{EMAIL}}':          hdr_email,
            '{{INTRO_LIGNE}}':    intro,
            '{{NIVEAU_ACTUEL}}':  prereqLevel,
            '{{NIVEAU_VISE}}':    targetLevel,
            '{{RESUME_SITUATION}}': resumeSituation,
            '{{TOTAL_HEURES}}':   totalHours,
            '{{COACHING_HEURES}}': coachingH,
            '{{FORMATEUR}}':      formateur,
            '{{HOMEWORK_HEURES}}': homeworkH,
            '{{DATE_DEBUT}}':     dateStart,
            '{{DATE_FIN}}':       dateEnd,
            '{{CERTIFICATION}}':  certification,
            '{{PRIX}}':           str(price_int) if price_int else str(price),
            '{{CPF_MONTANT}}':    str(cpf_montant),
            '{{RESTE_CHARGE}}':   str(reste_charge),
            '{{CPF_LIEN}}':       edofMCFLink,
        }

        # RENEWAL_PROPOSITION_FIX (2026-07-30): for renewals -
        # (a) remove the "Niveau actuel / Niveau vise" line entirely: no
        #     fresh evaluation on record, so any levels shown would be
        #     stale or dangling ("Niveau vise :" with nothing after it).
        # (b) the CPF funding split cannot be asserted: coverage depends on
        #     the credit remaining in the learner's own account. Replace
        #     the fixed amounts with credit-dependent wording. Runs BEFORE
        #     the generic substitution loop and rewrites the placeholder
        #     paragraphs directly (label and amount are separate paragraphs
        #     inside each table cell).
        if isRenewal:
            niveau_p = find_para_with(root, '{{NIVEAU_ACTUEL}}')
            if niveau_p is not None:
                remove_para(niveau_p)
            cpf_amount_p = find_para_with(root, '{{CPF_MONTANT}}')
            if cpf_amount_p is not None:
                set_para_text(cpf_amount_p,
                    'Jusqu\u2019\u00e0 1\u00a0500\u00a0\u20ac (selon le cr\u00e9dit dans votre compte)')
            reste_amount_p = find_para_with(root, '{{RESTE_CHARGE}}')
            if reste_amount_p is not None:
                set_para_text(reste_amount_p, 'Selon votre cr\u00e9dit')

        for p in root.iter(q('p')):
            for placeholder, value in substitutions.items():
                if placeholder in para_text(p):
                    replace_in_para(p, placeholder, value)

        # ── Objectives ───────────────────────────────────────────────────────
        for i, obj in enumerate(objectives[:6]):
            placeholder = '{{OBJECTIF_%d}}' % (i + 1)
            p = find_para_with(root, placeholder)
            if p is not None:
                set_para_text(p, obj)

        # TIERS_WORDING_FIX (2026-07-03): third-person section heading for
        # non-CPF proposals addressed to a third party. Graceful no-op (not a
        # hard failure) if the exact heading text is ever absent - a cosmetic
        # mismatch must never break live proposal generation.
        if (not isCPF) and recipientType == 'hr':
            capable_heading = find_para_with(root, 'vous serez capable de')
            if capable_heading is not None:
                replace_in_para(capable_heading, 'vous serez capable de', fullName + ' sera capable de')
            else:
                sys.stderr.write('TIERS_WORDING_FIX: heading "vous serez capable de" not found - left unchanged\n')
            # TIERS_HEADER_20260918: the two "Votre ..." section headings read
            # as addressed to the learner - reword for a third-party reader.
            for _old, _new in (('Votre profil', 'Profil de ' + fullName),
                               ('Votre programme sur mesure', 'Programme sur mesure')):
                _hp = find_para_with(root, _old)
                if _hp is not None:
                    replace_in_para(_hp, _old, _new)
                else:
                    sys.stderr.write('TIERS_HEADER_20260918: heading %r not found - left unchanged\n' % _old)

        # Remove unused objective placeholders
        for i in range(len(objectives) + 1, 7):
            placeholder = '{{OBJECTIF_%d}}' % i
            p = find_para_with(root, placeholder)
            if p is not None:
                remove_para(p)

        # ── Remove travail guidé row if no homework ──────────────────────────
        if not hasHomework:
            for label in ('Travail guidé en autonomie', '{{HOMEWORK_HEURES}} heures'):
                p = find_para_with(root, label)
                if p is None:
                    # Try after substitution
                    p = find_para_with(root, homeworkH + ' heures')
                if p is not None:
                    # Find the table row containing this para and remove it
                    parent = p.getparent()
                    # Walk up to find tc (table cell) then tr (table row)
                    el = parent
                    tr = None
                    for _ in range(5):
                        if el is None:
                            break
                        if el.tag == q('tr'):
                            tr = el
                            break
                        el = el.getparent()
                    if tr is not None:
                        tr.getparent().remove(tr)

        # ── {{ETAPE_2}} block ────────────────────────────────────────────────
        # PARCOURS_PROPOSITION_20260922: two-module parcours rendered as ONE
        # continued course (sections 2 and 3), financing detail in section 4.
        etape2_p = find_para_with(root, '{{ETAPE_2}}')
        if etape2_p is not None and parcours and parcours.get('calc') and parcours['calc'].get('modules'):
            _pc = parcours['calc']; _m1, _m2 = _pc['modules'][0], _pc['modules'][1]; _tt = _pc.get('totals') or {}
            _months = str(_pc.get('maxMonths', 12))
            _m1_title = _m1.get('title') or u'Anglais professionnel \u2013 parcours juridique (English 360)'
            _m2_title = _m2.get('title') or u'Communiquer en anglais juridique des affaires (CAJA)'
            _m1_dates = (u'du ' + dateStart + u' au ' + dateEnd) if dateStart and dateEnd else u''
            _m2_start = _fmt_date_fr(_m2.get('dateStart'))
            _m2_dates = (u'\u00e0 partir du ' + _m2_start) if _m2_start else u'\u00e0 l\u2019issue du Module 1'
            def _h(n):
                try: return str(int(float(n)))
                except (TypeError, ValueError): return str(n or '')
            # -- section 2 table -------------------------------------------------
            _p_total = find_para_with(root, u'Dur\u00e9e totale')
            _tr_total = _row_of(_p_total) if _p_total is not None else None
            if _tr_total is not None:
                _set_cell_texts(_tr_total, 1, [_h(_tt.get('totalHours')) + u' heures \u2013 parcours en deux modules sur ' + _months + u' mois maximum'])
                _tr_m1 = deepcopy(_tr_total); _tr_m2 = deepcopy(_tr_total)
                _set_cell_texts(_tr_m1, 0, [u'Module 1'])
                _set_cell_texts(_tr_m1, 1, [_m1_title + u' \u2013 ' + _h(_m1.get('totalHours')) + u' h' + (u' \u2013 ' + _m1_dates if _m1_dates else u'')])
                _set_cell_texts(_tr_m2, 0, [u'Module 2'])
                _set_cell_texts(_tr_m2, 1, [_m2_title + u' \u2013 ' + _h(_m2.get('totalHours')) + u' h \u2013 ' + _m2_dates])
                _tr_total.addnext(_tr_m1); _tr_m1.addnext(_tr_m2)
            _p_coach = find_para_with(root, u'Coaching individuel')
            _tr = _row_of(_p_coach) if _p_coach is not None else None
            if _tr is not None:
                _tcs = list(_tr.iter(q('tc')))
                _ps = list(_tcs[1].iter(q('p'))) if len(_tcs) > 1 else []
                if _ps:
                    set_para_text(_ps[0], _h(_tt.get('coachingHours')) + u' heures en visioconf\u00e9rence (' + _h(_m1.get('coachingHours')) + u' h par module)')
            _p_hw = find_para_with(root, u'Travail guid\u00e9 en autonomie')
            _tr = _row_of(_p_hw) if _p_hw is not None else None
            if _tr is not None:
                _hw_tot = (float(_m1.get('homeworkHours') or 0) + float(_m2.get('homeworkHours') or 0))
                _set_cell_texts(_tr, 1, [_h(_hw_tot) + u' heures (' + _h(_m1.get('homeworkHours')) + u' h par module)'])
            _p_per = find_para_with(root, u'P\u00e9riode')
            _tr = _row_of(_p_per) if _p_per is not None else None
            if _tr is not None:
                _set_cell_texts(_tr, 1, [u'Module 1 ' + _m1_dates + u' \u00b7 Module 2 ' + _m2_dates + u' \u2013 parcours r\u00e9alis\u00e9 sur ' + _months + u' mois maximum'])
            _p_cert = find_para_with(root, u'Certification')
            _tr = _row_of(_p_cert) if _p_cert is not None else None
            if _tr is not None:
                _set_cell_texts(_tr, 1, [u'Module 1\u00a0: ' + certification_e360(rsCode) + u' \u00b7 Module 2\u00a0: ' + CERTIFICATION_CAJA])
            # -- section 3 objectives --------------------------------------------
            _cap = find_para_with(root, u'vous serez capable de')
            if _cap is not None:
                replace_in_para(_cap, u'de cette formation', u'de ce parcours')
            # objectives were already substituted above -> locate the paragraphs by their text
            _obj_ps = [find_para_with(root, o) for o in (objectives or [])[:6]]
            _obj_ps = [p for p in _obj_ps if p is not None]
            _obj_template = deepcopy(_obj_ps[0]) if _obj_ps else None
            _label_template = deepcopy(etape2_p)
            if _obj_template is not None:
                # remove the template placeholders, rebuild the block after the heading
                _anchor = _cap if _cap is not None else _obj_ps[0].getprevious()
                for p in _obj_ps:
                    remove_para(p)
                _prev = _anchor
                _seq = []
                _seq.append((_label_template, u'Module 1 \u2013 ' + _m1_title))
                for o in (objectives or [])[:6]:
                    _seq.append((_obj_template, o))
                _seq.append((_label_template, u'Module 2 \u2013 ' + _m2_title))
                for o in CAJA_OBJECTIVES:
                    _seq.append((_obj_template, o))
                for _tpl, _txt in _seq:
                    _np = deepcopy(_tpl); set_para_text(_np, _txt); _prev.addnext(_np); _prev = _np
            # -- ETAPE_2 slot: one line ------------------------------------------
            set_para_text(etape2_p, u'Parcours en deux modules sous une convention globale\u00a0: l\u2019attestation de niveau B2 d\u00e9livr\u00e9e \u00e0 l\u2019issue du Module 1 constitue le pr\u00e9requis de la certification CAJA pr\u00e9par\u00e9e au Module 2.')
            # -- section 4: CPF table + plain funding lines ----------------------
            _p_bud = find_para_with(root, u'Budget total')
            _tr_bud = _row_of(_p_bud) if _p_bud is not None else None
            _p_forf = find_para_with(root, u'Participation forfaitaire')
            _tr_forf = _row_of(_p_forf) if _p_forf is not None else None
            if _tr_bud is not None and _tr_forf is not None:
                _tr_m2r = deepcopy(_tr_forf)  # light row style for Module 2; Total keeps the light row too
                _set_cell_texts(_tr_bud, 0, [u'Module 1 \u2013 English 360', _eur(_m1.get('price')) + u' NET DE TAXES'])
                _set_cell_texts(_tr_bud, 1, [u'Prise en charge CPF', _eur(_m1.get('cpfPart'))])
                _set_cell_texts(_tr_m2r, 0, [u'Module 2 \u2013 CAJA', _eur(_m2.get('price')) + u' NET DE TAXES'])
                _set_cell_texts(_tr_m2r, 1, [u'Prise en charge CPF', _eur(_m2.get('cpfPart'))])
                _tr_bud.addnext(_tr_m2r)
                _set_cell_texts(_tr_forf, 0, [u'Total du parcours', _eur(_tt.get('price')) + u' NET DE TAXES'])
                _set_cell_texts(_tr_forf, 1, [u'Reste \u00e0 votre charge', _eur(_tt.get('learner')) + u' (dont ' + _eur(_tt.get('forfait')) + u' de participation forfaitaire)'])
            _p_lien = find_para_with(root, u'Lien d\u2019inscription CPF')
            if _p_lien is not None:
                _plain = deepcopy(_p_lien)
                def _fund(m, label):
                    if m.get('route') == 'CPF':
                        return (label + u'\u00a0: ' + _eur(m.get('cpfPart')) + u' pris en charge par le CPF'
                                + ((u', ' + _eur(m.get('remainder')) + u' de compl\u00e9ment') if float(m.get('remainder') or 0) > 0 else u'')
                                + u' et ' + _eur(m.get('forfait')) + u' de participation forfaitaire, soit ' + _eur(m.get('learnerPays'))
                                + u' \u00e0 votre charge, r\u00e9gl\u00e9s lors de l\u2019inscription sur Mon Compte Formation.')
                    return (label + u'\u00a0: r\u00e8glement direct de ' + _eur(m.get('price')) + u' en ' + str(m.get('instalments') or 1)
                            + u' \u00e9ch\u00e9ances mensuelles (aucune participation forfaitaire).')
                _lines = [_fund(_m1, u'Module 1'), _fund(_m2, u'Module 2')]
                _dir = _pc.get('direct') or {}
                if float(_dir.get('saving') or 0) > 0:
                    _lines.append(u'\u00c0 titre de comparaison, les m\u00eames ' + _h(_tt.get('coachingHours')) + u' heures de coaching achet\u00e9es directement, hors certification, co\u00fbteraient ' + _eur(_dir.get('comparator')) + u'\u00a0: le parcours vous fait \u00e9conomiser ' + _eur(_dir.get('saving')) + u' et inclut deux certifications.')
                _lines.append(u'L\u2019inscription CPF ci-dessous concerne le Module 1\u00a0; celle du Module 2 se fait \u00e0 l\u2019issue du premier, dans le cadre de la m\u00eame convention.')
                _prev = _p_lien.getprevious()
                if _prev is None:
                    _prev = _p_lien
                _first = True
                for _ln in _lines:
                    _np = deepcopy(_plain); set_para_text(_np, _ln)
                    if _first and _prev is _p_lien:
                        _p_lien.addprevious(_np)
                    else:
                        _prev.addnext(_np)
                    _prev = _np; _first = False
            etape2_p = None
        etape2_p = find_para_with(root, '{{ETAPE_2}}')
        if etape2_p is not None:
            if cpfType == 'E360_LEGAL':
                set_para_text(etape2_p, ETAPE_2_TEXT)
            else:
                remove_para(etape2_p)

        # ── CPF / non-CPF conditional blocks ─────────────────────────────────
        if isCPF:
            remove_block(root, '{{IF_NON_CPF}}', '{{END_NON_CPF}}')
            keep_block_remove_markers(root, '{{IF_CPF}}', '{{END_CPF}}')
        else:
            keep_block_remove_markers(root, '{{IF_NON_CPF}}', '{{END_NON_CPF}}')
            remove_block(root, '{{IF_CPF}}', '{{END_CPF}}')

        # ── Enforce proven pgMar values ──────────────────────────────────────
        sectPr = body.find(q('sectPr'))
        if sectPr is not None:
            pgMar = sectPr.find(q('pgMar'))
            if pgMar is not None:
                pgMar.set(q('bottom'), '2800')
                pgMar.set(q('footer'), '400')

        # ── Save and repack ──────────────────────────────────────────────────
        tree.write(doc_path, xml_declaration=True, encoding='UTF-8', standalone=True)
        with zipfile.ZipFile(output_path, 'w', zipfile.ZIP_DEFLATED) as zout:
            for dirpath, dirs, files in os.walk(tmpdir):
                for f in files:
                    fp = os.path.join(dirpath, f)
                    zout.write(fp, os.path.relpath(fp, tmpdir))
    finally:
        shutil.rmtree(tmpdir)


if __name__ == '__main__':
    if len(sys.argv) == 4:
        data = json.load(open(sys.argv[1], encoding='utf-8'))
        fill_proposition(data, sys.argv[2], sys.argv[3])
        print('Done:', sys.argv[3])
    else:
        print('Usage: fill_proposition.py <data.json> <template.docx> <output.docx>')
        sys.exit(1)
